extends "res://scripts/character.gd"
## Drives assets/hero/hero.glb: a smoothly skinned adult explorer (generated by tools/hero_export.py) with a
## 16-bone skeleton whose bone names equal the joint names used by character.gd. The SAME procedural pose
## system (idle, walk, run, jump, crouch, chop, gather, carry, aim, build) rotates the bones.
## No animation clips are stored in the GLB. Tool sockets: ToolSocket_R / ToolSocket_L (on the hands).
const HERO_PATH := "res://assets/hero/hero.glb"
const BONES := ["hips", "spine", "chest", "head", "shL", "elL", "handL", "shR", "elR", "handR",
	"hipL", "knL", "anL", "hipR", "knR", "anR"]
var model: Node3D
var skel: Skeleton3D
var idx := {}
var rest_hips_y := 0.92
var socket_r: Node3D
var socket_l: Node3D
var tool_axe: Node3D
var tool_pick: Node3D
var tool_hammer: Node3D

func is_skinned_ok() -> bool:
	return skel != null and idx.size() == BONES.size()

func _attach(bone: String) -> Node3D:
	var att := BoneAttachment3D.new()
	att.name = "Attach_" + bone
	att.bone_name = bone
	skel.add_child(att)
	var n := Node3D.new()
	n.rotation.y = PI          # model front is +Z; sockets use the game's char frame (front = -Z)
	att.add_child(n)
	return n

func _ready() -> void:
	var scn = load(HERO_PATH)
	if not (scn is PackedScene):
		push_error("hero.glb missing or not importable")
		return
	model = scn.instantiate()
	model.rotation.y = PI
	add_child(model)
	var sks := model.find_children("*", "Skeleton3D", true, false)
	if sks.is_empty():
		push_error("hero.glb has no Skeleton3D")
		return
	skel = sks[0]
	for b in BONES:
		idx[b] = skel.find_bone(b)
		if int(idx[b]) < 0:
			push_error("hero.glb missing bone " + b)
			skel = null
			return
		_joint(self, b, Vector3.ZERO)          # driver joints (flat) used by character.gd's animate()
	(J["hips"] as Node3D).position = Vector3(0, 0.95, 0)
	rest_hips_y = skel.get_bone_rest(idx["hips"]).origin.y
	for mi in model.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		for i in m.mesh.get_surface_count():
			var src := m.get_active_material(i)
			if src is StandardMaterial3D:
				var mat: StandardMaterial3D = src.duplicate()
				mat.vertex_color_use_as_albedo = true
				m.set_surface_override_material(i, mat)
	# tool sockets in the hands + props
	var wood := M.pbr("bark", Color(0.9, 0.8, 0.65), 1.5, 0.9)
	var metal := M.flat(Color(0.62, 0.64, 0.68), 0.35)
	socket_r = _attach("handR")
	socket_r.name = "ToolSocket_R"
	socket_r.position = Vector3(0, -0.07, 0)
	socket_l = _attach("handL")
	socket_l.name = "ToolSocket_L"
	socket_l.position = Vector3(0, -0.07, 0)
	tool_axe = Node3D.new()
	socket_r.add_child(tool_axe)
	_cyl(tool_axe, 0.016, 0.72, wood, Vector3(0, -0.18, 0))
	_box(tool_axe, Vector3(0.03, 0.11, 0.17), metal, Vector3(0, -0.5, -0.07))
	tool_pick = Node3D.new()
	socket_r.add_child(tool_pick)
	_cyl(tool_pick, 0.017, 0.8, wood, Vector3(0, -0.2, 0))
	_box(tool_pick, Vector3(0.03, 0.04, 0.42), metal, Vector3(0, -0.58, 0))
	_box(tool_pick, Vector3(0.03, 0.06, 0.06), metal, Vector3(0, -0.58, -0.22), Vector3(0.5, 0, 0))
	_box(tool_pick, Vector3(0.03, 0.06, 0.06), metal, Vector3(0, -0.58, 0.22), Vector3(-0.5, 0, 0))
	tool_hammer = Node3D.new()
	socket_r.add_child(tool_hammer)
	_cyl(tool_hammer, 0.018, 0.5, wood, Vector3(0, -0.12, 0))
	_box(tool_hammer, Vector3(0.07, 0.07, 0.15), metal, Vector3(0, -0.4, 0))
	axe = tool_axe
	tool_pick.visible = false
	tool_hammer.visible = false
	# carried stone in front of the chest
	stone = _attach("chest")
	stone.position = Vector3(0, -0.1, -0.27)
	stone.visible = false
	_mi(stone, G.rock(77, 1), M.pbr("rock", Color.WHITE, 0.5), Vector3.ZERO, Vector3.ZERO, Vector3.ONE * 0.2)

func animate(d: float, spd: float, on_floor: bool, vy: float, crouch: bool, action: String, carrying: bool) -> void:
	if skel == null:
		return
	super.animate(d, spd, on_floor, vy, crouch, action, carrying)
	# char-frame (front -Z) rotations -> model-frame (front +Z): conjugation by a 180 deg yaw flips X and Z
	for b in BONES:
		var r: Vector3 = (J[b] as Node3D).rotation
		skel.set_bone_pose_rotation(idx[b], Basis.from_euler(Vector3(-r.x, r.y, -r.z)).get_rotation_quaternion())
	var dy := ((J["hips"] as Node3D).position.y - 0.95) * 1.25
	skel.set_bone_pose_position(idx["hips"], Vector3(0, maxf(0.42, rest_hips_y + dy), 0))
	var show_pick := action == "gather"
	var show_hammer := action == "build"
	var show_axe := not carrying and not show_pick and not show_hammer
	tool_axe.visible = show_axe or action == "chop"
	tool_pick.visible = show_pick
	tool_hammer.visible = show_hammer
