extends "res://scripts/character.gd"
## Drives assets/hero/hero.glb: a smoothly skinned adult explorer (generated by tools/hero_export.py) with a
## 16-bone skeleton whose bone names equal the joint names used by character.gd. The SAME procedural pose
## system (idle, walk, run, jump, crouch, chop, gather, carry, aim, build) rotates the bones.
## No animation clips are stored in the GLB. Tool sockets: ToolSocket_R / ToolSocket_L (on the hands).
const HERO_PATH := "res://assets/hero/hero.glb"
const BONES := ["hips", "spine", "chest", "head", "shL", "elL", "handL", "shR", "elR", "handR",
	"hipL", "knL", "anL", "hipR", "knR", "anR"]
var model: Node3D
var skel: Skeleton3D
var idx := {}
var rest_hips_y := 0.92
var socket_r: Node3D
var socket_l: Node3D
var tool_axe: Node3D
var tool_pick: Node3D
var tool_hammer: Node3D
var w_sling: Node3D
var w_bow: Node3D
var w_xbow: Node3D
var sling_a: MeshInstance3D
var sling_b: MeshInstance3D
var pouch: MeshInstance3D
var bow_s1: MeshInstance3D
var bow_s2: MeshInstance3D
var arrow: MeshInstance3D
var xbow_scope: Node3D
const EXPR := ["smile", "surprise", "focus", "fear", "tired"]
var pack_i := -1
var pack_x := 0.0
var pack_v := 0.0
var prev_vy := 0.0
var head_mi: MeshInstance3D
var blend_idx := {}
var expr_cur := {}
var emote_name := ""
var emote_t := 0.0
var run_t := 0.0

## cylinder of unit height; _place() stretches it between two points (rubber bands, bow strings, arrows)
func _link(parent: Node3D, mat: Material, r: float) -> MeshInstance3D:
	var c := CylinderMesh.new()
	c.top_radius = r
	c.bottom_radius = r
	c.height = 1.0
	c.radial_segments = 6
	var mi := MeshInstance3D.new()
	mi.mesh = c
	mi.material_override = mat
	parent.add_child(mi)
	return mi

func _place(mi: MeshInstance3D, a: Vector3, b: Vector3) -> void:
	var dv := b - a
	var ln := dv.length()
	if ln < 0.001:
		mi.visible = false
		return
	mi.visible = true
	var y := dv / ln
	var ref := Vector3.FORWARD if absf(y.dot(Vector3.UP)) > 0.9 else Vector3.UP
	var x := ref.cross(y).normalized()
	var z := x.cross(y)
	mi.transform = Transform3D(Basis(x, y * ln, z), (a + b) * 0.5)

func _build_weapons() -> void:
	# authored in the hand's frame: the aiming direction is -Y, "up" is -Z (arm raised forward)
	var wood := M.pbr("bark", Color(0.9, 0.8, 0.65), 1.5, 0.9)
	var dark := M.flat(Color(0.12, 0.1, 0.08), 0.7)
	var metal := M.flat(Color(0.62, 0.64, 0.68), 0.35)
	var rubber := M.flat(Color(0.55, 0.15, 0.1), 0.8)
	var cord := M.flat(Color(0.85, 0.8, 0.65), 0.9)
	# slingshot (right hand)
	w_sling = Node3D.new()
	socket_r.add_child(w_sling)
	_cyl(w_sling, 0.018, 0.14, wood, Vector3(0, -0.07, 0))
	for sx in [-1.0, 1.0]:
		_place(_link(w_sling, wood, 0.013), Vector3(0, -0.14, 0), Vector3(sx * 0.045, -0.21, -0.08))
	sling_a = _link(w_sling, rubber, 0.006)
	sling_b = _link(w_sling, rubber, 0.006)
	pouch = _sph(w_sling, 0.02, dark, Vector3(0, -0.17, -0.02))
	# bow (left hand): limbs along Z, belly toward the archer (+Y)
	w_bow = Node3D.new()
	socket_l.add_child(w_bow)
	var pts: Array = []
	for i in 9:
		var s := -0.55 + 1.1 * i / 8.0
		pts.append(Vector3(0, 0.13 * pow(s / 0.55, 2.0), s))
	for i in 8:
		_place(_link(w_bow, wood, 0.016 - 0.006 * absf(float(i) - 3.5) / 3.5), pts[i], pts[i + 1])
	_box(w_bow, Vector3(0.035, 0.045, 0.12), dark, Vector3.ZERO)
	bow_s1 = _link(w_bow, cord, 0.004)
	bow_s2 = _link(w_bow, cord, 0.004)
	arrow = _link(w_bow, wood, 0.004)
	# crossbow (right hand): stock + curved prod + string + bolt + optional scope
	w_xbow = Node3D.new()
	socket_r.add_child(w_xbow)
	_box(w_xbow, Vector3(0.05, 0.72, 0.07), wood, Vector3(0, -0.2, 0))
	var prod: Array = []
	for i in 9:
		var s2 := -0.34 + 0.68 * i / 8.0
		prod.append(Vector3(s2, -0.52 + 0.09 * pow(s2 / 0.34, 2.0), 0))
	for i in 8:
		_place(_link(w_xbow, dark, 0.014), prod[i], prod[i + 1])
	_place(_link(w_xbow, cord, 0.004), prod[0], Vector3(0, -0.2, 0))
	_place(_link(w_xbow, cord, 0.004), Vector3(0, -0.2, 0), prod[8])
	_place(_link(w_xbow, metal, 0.006), Vector3(0, -0.2, -0.045), Vector3(0, -0.6, -0.045))
	xbow_scope = Node3D.new()
	w_xbow.add_child(xbow_scope)
	_cyl(xbow_scope, 0.022, 0.24, dark, Vector3(0, -0.2, -0.09))
	_cyl(xbow_scope, 0.027, 0.03, metal, Vector3(0, -0.31, -0.09))
	_cyl(xbow_scope, 0.027, 0.03, metal, Vector3(0, -0.09, -0.09))
	xbow_scope.visible = false

func set_scoped(on: bool) -> void:
	if xbow_scope:
		xbow_scope.visible = on

func _update_weapons(aiming: bool, carrying: bool, action: String, k: float) -> void:
	var held := not carrying and action != "chop" and action != "gather" and action != "build"
	w_sling.visible = held and weapon == "slingshot"
	w_bow.visible = held and weapon == "bow"
	w_xbow.visible = held and weapon == "crossbow"
	# carried low vs raised to aim
	w_sling.rotation.x = lerpf(w_sling.rotation.x, 0.0 if aiming else PI, k)
	w_bow.rotation.x = lerpf(w_bow.rotation.x, 0.0 if aiming else PI / 2.0, k)
	w_xbow.rotation.x = lerpf(w_xbow.rotation.x, 0.0 if aiming else 0.5, k)
	if w_sling.visible:
		var p := Vector3(0, -0.17, -0.02)
		if aiming:
			p = w_sling.to_local(socket_l.global_position)     # the band follows the pulling hand
		_place(sling_a, Vector3(-0.045, -0.21, -0.08), p)
		_place(sling_b, Vector3(0.045, -0.21, -0.08), p)
		pouch.position = p
	if w_bow.visible:
		var tt := Vector3(0, 0.13, -0.55)
		var tb := Vector3(0, 0.13, 0.55)
		if aiming:
			var dp := w_bow.to_local(socket_r.global_position)  # string is drawn to the right hand
			_place(bow_s1, tt, dp)
			_place(bow_s2, dp, tb)
			_place(arrow, dp, dp + Vector3(0, -0.75, 0))
		else:
			_place(bow_s1, tt, tb)
			bow_s2.visible = false
			arrow.visible = false

func is_skinned_ok() -> bool:
	return skel != null and idx.size() == BONES.size()

## True when the 5 facial expression blend shapes were imported from the Head mesh.
func face_ready() -> bool:
	return head_mi != null and blend_idx.size() == EXPR.size()

func _attach(bone: String) -> Node3D:
	var att := BoneAttachment3D.new()
	att.name = "Attach_" + bone
	att.bone_name = bone
	skel.add_child(att)
	var n := Node3D.new()
	n.rotation.y = PI          # model front is +Z; sockets use the game's char frame (front = -Z)
	att.add_child(n)
	return n

func _ready() -> void:
	var scn = load(HERO_PATH)
	if not (scn is PackedScene):
		push_error("hero.glb missing or not importable")
		return
	model = scn.instantiate()
	model.rotation.y = PI
	add_child(model)
	var sks := model.find_children("*", "Skeleton3D", true, false)
	if sks.is_empty():
		push_error("hero.glb has no Skeleton3D")
		return
	skel = sks[0]
	for b in BONES:
		idx[b] = skel.find_bone(b)
		if int(idx[b]) < 0:
			push_error("hero.glb missing bone " + b)
			skel = null
			return
		_joint(self, b, Vector3.ZERO)          # driver joints (flat) used by character.gd's animate()
	(J["hips"] as Node3D).position = Vector3(0, 0.95, 0)
	rest_hips_y = skel.get_bone_rest(idx["hips"]).origin.y
	pack_i = skel.find_bone("pack")           # optional backpack bone (secondary motion)
	for mi in model.find_children("*", "MeshInstance3D", true, false):
		var m := mi as MeshInstance3D
		if m.name == "HeroDetail":              # stitching, zips, buckles, laces, emblems: cheap LOD
			m.visibility_range_end = 14.0
			m.visibility_range_end_margin = 3.0
			m.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_SELF
			m.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		elif m.name == "Head":
			head_mi = m
			for en in EXPR:
				var bi := m.find_blend_shape_by_name(en)
				if bi >= 0:
					blend_idx[en] = bi
		for i in m.mesh.get_surface_count():
			var src := m.get_active_material(i)
			if src is StandardMaterial3D:
				var mat: StandardMaterial3D = src.duplicate()
				mat.vertex_color_use_as_albedo = true
				m.set_surface_override_material(i, mat)
	# tool sockets in the hands + props
	var wood := M.pbr("bark", Color(0.9, 0.8, 0.65), 1.5, 0.9)
	var metal := M.flat(Color(0.62, 0.64, 0.68), 0.35)
	socket_r = _attach("handR")
	socket_r.name = "ToolSocket_R"
	socket_r.position = Vector3(0, -0.07, 0)
	socket_l = _attach("handL")
	socket_l.name = "ToolSocket_L"
	socket_l.position = Vector3(0, -0.07, 0)
	tool_axe = Node3D.new()
	socket_r.add_child(tool_axe)
	_cyl(tool_axe, 0.016, 0.72, wood, Vector3(0, -0.18, 0))
	_box(tool_axe, Vector3(0.03, 0.11, 0.17), metal, Vector3(0, -0.5, -0.07))
	tool_pick = Node3D.new()
	socket_r.add_child(tool_pick)
	_cyl(tool_pick, 0.017, 0.8, wood, Vector3(0, -0.2, 0))
	_box(tool_pick, Vector3(0.03, 0.04, 0.42), metal, Vector3(0, -0.58, 0))
	_box(tool_pick, Vector3(0.03, 0.06, 0.06), metal, Vector3(0, -0.58, -0.22), Vector3(0.5, 0, 0))
	_box(tool_pick, Vector3(0.03, 0.06, 0.06), metal, Vector3(0, -0.58, 0.22), Vector3(-0.5, 0, 0))
	tool_hammer = Node3D.new()
	socket_r.add_child(tool_hammer)
	_cyl(tool_hammer, 0.018, 0.5, wood, Vector3(0, -0.12, 0))
	_box(tool_hammer, Vector3(0.07, 0.07, 0.15), metal, Vector3(0, -0.4, 0))
	_build_weapons()
	axe = tool_axe
	tool_pick.visible = false
	tool_hammer.visible = false
	# carried stone in front of the chest
	stone = _attach("chest")
	stone.position = Vector3(0, -0.1, -0.27)
	stone.visible = false
	_mi(stone, G.rock(77, 1), M.pbr("rock", Color.WHITE, 0.5), Vector3.ZERO, Vector3.ZERO, Vector3.ONE * 0.2)

## Facial expression for a moment (smile, surprise, focus, fear, tired). Automatic ones: focus while aiming,
## surprise while falling fast, tired after a long run.
func emote(emo: String, secs: float = 1.8) -> void:
	emote_name = emo
	emote_t = secs

func _update_face(d: float, spd: float, on_floor: bool, vy: float, action: String) -> void:
	if head_mi == null:
		return
	run_t = run_t + d if spd > 4.5 else maxf(0.0, run_t - d * 2.0)
	var want := ""
	if emote_t > 0.0:
		emote_t -= d
		want = emote_name
	elif action == "aim":
		want = "focus"
	elif not on_floor and vy < -4.0:
		want = "surprise"
	elif run_t > 18.0:
		want = "tired"
	for en in EXPR:
		var tgt := (1.0 if en == "smile" else 0.85) if en == want else 0.0
		expr_cur[en] = lerpf(float(expr_cur.get(en, 0.0)), tgt, clampf(d * 6.0, 0.0, 1.0))
		if blend_idx.has(en):
			head_mi.set_blend_shape_value(int(blend_idx[en]), float(expr_cur[en]))

## Tiny spring on the 'pack' bone: the backpack lags behind jumps/landings, bounces with steps, sways in turns.
func _update_pack(d: float, on_floor: bool, vy: float, turn: float) -> void:
	if pack_i < 0:
		return
	var acc := vy - prev_vy
	if not on_floor:
		acc += 18.0 * d                          # ignore plain gravity in free fall
	prev_vy = vy
	pack_v += clampf(-acc * 0.6, -0.5, 0.5)
	pack_v += (-pack_x * 90.0 - pack_v * 11.0) * d
	pack_x = clampf(pack_x + pack_v * d, -0.05, 0.05)
	var bounce := sin(phase * 2.0) * 0.015 * walk_w
	var q := Quaternion(Vector3.RIGHT, pack_x + bounce) * Quaternion(Vector3.UP, clampf(-turn * 0.008, -0.03, 0.03))
	skel.set_bone_pose_rotation(pack_i, q)

func animate(d: float, spd: float, on_floor: bool, vy: float, crouch: bool, action: String, carrying: bool, turn: float = 0.0) -> void:
	if skel == null:
		return
	super.animate(d, spd, on_floor, vy, crouch, action, carrying, turn)
	# char-frame (front -Z) rotations -> model-frame (front +Z): conjugation by a 180 deg yaw flips X and Z
	for b in BONES:
		var r: Vector3 = (J[b] as Node3D).rotation
		skel.set_bone_pose_rotation(idx[b], Basis.from_euler(Vector3(-r.x, r.y, -r.z)).get_rotation_quaternion())
	var dy := ((J["hips"] as Node3D).position.y - 0.95) * 1.25
	skel.set_bone_pose_position(idx["hips"], Vector3(0, maxf(0.42, rest_hips_y + dy), 0))
	# what is in the hand: work tool during chop / gather / build, otherwise the SELECTED WEAPON
	tool_axe.visible = action == "chop"
	tool_pick.visible = action == "gather"
	tool_hammer.visible = action == "build"
	_update_weapons(action == "aim", carrying, action, clampf(d * 10.0, 0.0, 1.0))
	_update_pack(d, on_floor, vy, turn)
	_update_face(d, spd, on_floor, vy, action)
