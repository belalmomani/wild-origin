extends RefCounted
## Material/texture factory with cache. All textures are generated by tools/gen_textures.py.
const TEX := "res://assets/textures/"
static var _cache := {}

static func tex(name: String) -> Texture2D:
	if not _cache.has(name):
		_cache[name] = load(TEX + name + ".png")
	return _cache[name]

## PBR-ish material from <name>_a.png (+ <name>_n.png). triplanar = no UVs needed (rocks, bark, ...).
static func pbr(name: String, tint: Color = Color.WHITE, scale: float = 1.0, rough: float = 0.9, triplanar: bool = true) -> StandardMaterial3D:
	var key := "m_%s_%s_%s_%s" % [name, tint.to_html(), scale, triplanar]
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex(name + "_a")
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = tex(name + "_n")
	m.normal_scale = 0.8
	m.roughness = rough
	m.uv1_scale = Vector3(scale, scale, scale)
	m.uv1_triplanar = triplanar
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	_cache[key] = m
	return m

## Alpha-cut foliage card material (leaf textures). Per-card tint comes from vertex colours.
static func leaf(name: String) -> StandardMaterial3D:
	var key := "leaf_" + name
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex(name)
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
	m.alpha_scissor_threshold = 0.5
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	m.vertex_color_use_as_albedo = true
	m.roughness = 0.85
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	_cache[key] = m
	return m

static func flat(c: Color, rough: float = 0.8) -> StandardMaterial3D:
	var key := "f_%s_%s" % [c.to_html(), rough]
	if _cache.has(key):
		return _cache[key]
	var m := StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	_cache[key] = m
	return m

static func terrain() -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load("res://assets/shaders/terrain.gdshader")
	for n in ["grass_a", "dirt_a", "gravel_a", "rock_a", "grass_n", "rock_n"]:
		m.set_shader_parameter(n, tex(n))
	return m
