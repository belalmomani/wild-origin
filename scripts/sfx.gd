extends Node
## Audio: SFX pool, day/night ambience cross-fade, music, positional chicken clucks.
## All WAVs are generated by tools/gen_audio.py (no third-party audio).
const DIR := "res://assets/audio/"
const NAMES := ["chop", "rock", "place", "step1", "step2", "click", "shot_sling", "shot_bow", "hit", "water",
	"harvest", "chime", "jump", "cluck", "ambient_day", "ambient_night", "music"]
var _cache := {}
var _pool: Array = []
var amb_day: AudioStreamPlayer
var amb_night: AudioStreamPlayer
var music: AudioStreamPlayer
var cluck: AudioStreamPlayer3D
var _step_t := 0.0
var _step_i := 0

func is_ready() -> bool:
	for n in NAMES:
		if _stream(n) == null:
			return false
	return true

func _stream(n: String) -> AudioStream:
	if not _cache.has(n):
		_cache[n] = load(DIR + n + ".wav")
	return _cache[n]

func _loop(n: String, db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	var s = _stream(n)
	if s is AudioStreamWAV:
		var w := s as AudioStreamWAV
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = w.data.size() / 2        # 16-bit mono: samples = bytes / 2
	p.stream = s
	p.volume_db = db
	add_child(p)
	if s != null:
		p.play()
	return p

func _ready() -> void:
	for i in 8:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_pool.append(p)
	amb_day = _loop("ambient_day", -80.0)
	amb_night = _loop("ambient_night", -80.0)
	music = _loop("music", -22.0)
	cluck = AudioStreamPlayer3D.new()
	cluck.stream = _stream("cluck")
	cluck.unit_size = 8.0
	cluck.max_distance = 45.0
	add_child(cluck)

func play(n: String, db: float = 0.0, pitch: float = 1.0) -> void:
	var s := _stream(n)
	if s == null:
		return
	for p in _pool:
		if not (p as AudioStreamPlayer).playing:
			p.stream = s
			p.volume_db = db
			p.pitch_scale = pitch
			p.play()
			return

func play_at(pos: Vector3) -> void:
	if cluck.stream != null and not cluck.playing:
		cluck.global_position = pos
		cluck.pitch_scale = randf_range(0.9, 1.15)
		cluck.play()

## Footsteps from movement speed (call every frame while playing).
func footsteps(d: float, speed: float, on_floor: bool, crouching: bool) -> void:
	if not on_floor or speed < 0.6:
		_step_t = 0.0
		return
	_step_t += d
	if _step_t >= clampf(0.6 - speed * 0.05, 0.3, 0.6):
		_step_t = 0.0
		_step_i += 1
		play("step1" if _step_i % 2 == 0 else "step2", -14.0 if crouching else -9.0, randf_range(0.9, 1.1))

func update(d: float, hour: float, in_world: bool) -> void:
	var elev := sin((hour - 6.0) / 24.0 * TAU)
	var day := clampf(elev * 3.0 + 0.5, 0.0, 1.0)
	var k := clampf(d * 2.0, 0.0, 1.0)
	var dd := linear_to_db(maxf(day * 0.7, 0.001)) if in_world else -80.0
	var nn := linear_to_db(maxf((1.0 - day) * 0.55, 0.001)) if in_world else -80.0
	amb_day.volume_db = lerpf(amb_day.volume_db, dd, k)
	amb_night.volume_db = lerpf(amb_night.volume_db, nn, k)
	music.volume_db = lerpf(music.volume_db, -26.0 if in_world else -14.0, k)
